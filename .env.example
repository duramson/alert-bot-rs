# Required
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
POSTGRES_PASSWORD=change-me

# Webhook deployment (recommended). Leave WEBHOOK_URL empty to use long polling.
# Point an external reverse proxy / Cloudflare Tunnel at the LXC's :8080.
# WEBHOOK_URL=https://alert.example.de/webhook
# WEBHOOK_SECRET=$(openssl rand -hex 32)

# Admin chat for ops notifications (start, shutdown, worker errors).
# Your numeric Telegram user id — message @userinfobot to find yours.
# ADMIN_CHAT_ID=324855588

# Defaults
POSTGRES_USER=alertbot
POSTGRES_DB=alertbot
RUST_LOG=info,alert_bot=debug

# On the production LXC, layer the prod override so `docker compose ...`
# pulls the CI-built image instead of building locally:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
