# Local development settings. Production uses /etc/alert-bot/config.env
# on the LXC instead — see README.md → "Production deployment".

# Required
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Local dev: docker-compose.yml starts a postgres container with this
# password. Keep the URL below in sync.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://alertbot:change-me@127.0.0.1:5432/alertbot

# Webhook deployment (recommended in prod). Leave WEBHOOK_URL empty in
# dev to fall back to long-polling — no public endpoint needed.
# WEBHOOK_URL=https://alert.example.de/webhook
# WEBHOOK_SECRET=$(openssl rand -hex 32)
# WEBHOOK_LISTEN=0.0.0.0:8080

# Admin chat for ops notifications (start, shutdown, worker errors).
# Your numeric Telegram user id — message @userinfobot to find yours.
# ADMIN_CHAT_ID=324855588

# Defaults
POSTGRES_USER=alertbot
POSTGRES_DB=alertbot
RUST_LOG=info,alert_bot=debug
