# Required
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
POSTGRES_PASSWORD=change-me

# Webhook deployment (recommended). Leave WEBHOOK_URL empty to use long polling.
# WEBHOOK_URL=https://alert.example.de/webhook
# WEBHOOK_SECRET=$(openssl rand -hex 32)

# Cloudflare Tunnel (optional, run with `docker compose --profile tunnel up`).
# CLOUDFLARED_TOKEN=eyJh...

# Defaults
POSTGRES_USER=alertbot
POSTGRES_DB=alertbot
RUST_LOG=info,alert_bot=debug
